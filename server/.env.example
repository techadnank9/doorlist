# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Required: finds and ranks events (Responses API with web search).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Optional but recommended: real event pages from Luma, Partiful, Eventbrite, Meetup.
EXA_API_KEY=

# Optional: voice answers. Without it the app falls back to Apple speech on the phone.
ELEVENLABS_API_KEY=

# Shared with the app build (DoorlistAppToken in project.yml). A speed bump, not real auth;
# switch to App Attest before a public launch.
APP_TOKEN=change-me

# Per install, per day.
SEARCH_LIMIT_PER_DAY=40
TRANSCRIBE_LIMIT_PER_DAY=120

# Sign in with Apple: the app's bundle id, and a long random string that signs Doorlist sessions.
APPLE_BUNDLE_ID=com.techadnank9.doorlist
SESSION_SECRET=

# Opens the live cost dashboard: https://<server>/admin?token=<ADMIN_TOKEN>
ADMIN_TOKEN=

# Postgres: profiles (answers, history) and the cost meter. Render fills this in from the database.
DATABASE_URL=postgres://postgres:test@localhost:55432/doorlist

# Prices in USD, list prices as of Oct 2026. Update when providers change them.
PRICE_OPENAI_INPUT_PER_MTOK=10
PRICE_OPENAI_CACHED_PER_MTOK=1
PRICE_OPENAI_OUTPUT_PER_MTOK=50
PRICE_OPENAI_WEB_SEARCH_PER_1K=10
PRICE_SCRIBE_PER_HOUR=0.22
PRICE_SCRIBE_KEYTERMS_PER_HOUR=0.05

PORT=8787
